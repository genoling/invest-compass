# ==========================================
# 智投罗盘 - 环境变量配置模板
# 复制本文件为 .env.local 并填入真实密钥：
#   cp .env.local.example .env.local
#
# ⚠️ 安全警告：
# - .env.local 含真实密钥，已被 .gitignore 排除，绝不提交到 Git
# - 所有 API Key / Token 必须存放于此，禁止硬编码到源码
# - 提交代码前检查 git status，确保 .env.local 未被暂存
# ==========================================

# ----- Firebase（必填，来自 Firebase 控制台） -----
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ----- Finnhub 行情数据（可选，Mock 数据无需） -----
VITE_FINNHUB_API_KEY=your_finnhub_key

# ----- Alpha Vantage 行情数据（可选） -----
VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
